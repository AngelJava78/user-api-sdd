# Configuración de entorno — valores de ejemplo, no secretos
APP_ENV=development
APP_NAME=users-api
LOG_LEVEL=INFO

# PostgreSQL local (infra/docker-compose.yml)
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=<database>
# Puerto publicado en el host. En Windows 5432 puede caer en un rango reservado
# (ver `netsh interface ipv4 show excludedportrange protocol=tcp`); usar p. ej. 55432.
POSTGRES_PORT=5432

# PostgreSQL (driver asyncpg). Desde el host: <host>=localhost, <port>=POSTGRES_PORT.
# Dentro de Compose, el servicio api la sobrescribe para apuntar a db:5432.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5

# Servidor
WEB_CONCURRENCY=2   # workers por réplica; mínimo 2 réplicas en producción

# Paginación
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# Disponibilidad (ADR-0008)
SHUTDOWN_GRACE_SECONDS=30
READINESS_DB_TIMEOUT_SECONDS=2
